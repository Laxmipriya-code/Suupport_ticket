# Use a Groq Free Plan key for zero-cost evaluation. Never commit your real .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DATA_PATH=data/support_tickets.csv
DATA_TIMEZONE=UTC
PROVIDER_TIMEOUT=15
REQUEST_TIMEOUT=60
LANGSMITH_TRACING=false
# run.py sets API_BASE_URL for the UI automatically.
# If starting Streamlit separately, export API_BASE_URL in that terminal.
